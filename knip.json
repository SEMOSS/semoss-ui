{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"ignoreExportsUsedInFile": true,
	"ignoreIssues": {
		"**/vitest.setup.ts": ["files"],
		"**/*.test-fixtures.ts": ["files"],
		"**/*.fixtures.ts": ["files"],
		"**/test-utils/**": ["files"],
		"libs/renderer/src/testing/**": ["files"],
		"packages/collaboration/dev-server.ts": ["files"],
		"libs/ui/src/{hooks,next}/**": ["exports", "types"]
	},
	"workspaces": {
		"libs/panels": {
			"entry": ["src/vite/ai-sdk-stub.ts!"]
		},
		"packages/playground-desktop": {
			"entry": [
				"src/main/main.ts!",
				"src/preload/preload.ts!",
				"src/renderer/main.tsx!",
				"electron.vite.config.ts"
			],
			"ignoreDependencies": [
				"@semoss/connectors",
				"@semoss/workbench",
				"@tailwindcss/vite",
				"@vitejs/plugin-react",
				"postcss",
				"rolldown",
				"unplugin-dts",
				"vite-plugin-svgr"
			]
		},
		"packages/playground": {
			"ignoreDependencies": ["@semoss/connectors", "@semoss/workbench"]
		}
	},
	"ignoreDependencies": ["@vitest/coverage-v8"]
}
