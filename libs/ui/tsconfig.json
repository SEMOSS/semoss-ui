{
	"compilerOptions": {
		/* Lang and Env */
		"lib": ["ES2022", "dom"],
		"target": "es6",
		"jsx": "react-jsx",

		/* Modules */
		"module": "esnext",
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,

		/* Emit */
		"rootDir": "./src",
		"declaration": true,
		"outDir": "./dist",
		"declarationDir": "./dist/types",
		"emitDeclarationOnly": true,

		/* Skip */
		"skipLibCheck": true,
		"allowJs": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"strict": false,
		"noUncheckedSideEffectImports": false,

		/* Lang and Env */
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": [
		"src/index.ts",
		"src/hooks/**/*",
		"src/lib/**/*",
		"src/next/**/*",
		"src/styles/**/*"
	],
	"exclude": ["dist", "node_modules", "**/*.spec.ts"]
}
