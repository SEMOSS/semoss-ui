{
	"name": "@semoss/monolith",
	"version": "5.5.0-snapshot",
	"private": true,
	"description": "Typed, documented client for every SEMOSS (Monolith) REST endpoint. Works in Node and the browser.",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"default": "./dist/index.mjs"
		},
		"./*": {
			"types": "./dist/types/routes/*.d.ts",
			"default": "./dist/routes/*.mjs"
		}
	},
	"files": ["dist", "src"],
	"scripts": {
		"dev": "vite build --watch --mode development --configLoader runner",
		"build": "vite build --configLoader runner",
		"build:dev": "vite build --mode development --configLoader runner"
	},
	"license": "ISC",
	"devDependencies": {
		"@semoss/config": "workspace:*",
		"@types/node": "^24.3.1",
		"typescript": "~6.0.0",
		"vite": "^8.2.1"
	}
}
