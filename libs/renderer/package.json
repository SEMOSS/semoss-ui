{
    "name": "@semoss/renderer",
    "description": "Semoss Renderer - React library that allows you to build custom ui's through ui building blocks",
    "version": "1.0.0-alpha.21",
    "type": "module",
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/types/index.d.ts",
    "unpkg": "",
    "jsDeliver": "",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs",
            "default": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "dev": "rollup -w -c",
        "build": "rollup -c --environment NODE_ENV:production",
        "build:dev": "rollup -c",
        "build:umd": "rollup -c rollup.config.umd.js",
        "test": "vitest run",
        "test:watch": "vitest --watch"
    },
    "keywords": [],
    "author": "Semoss Team",
    "bugs": "https://github.com/SEMOSS/semoss-ui/issues",
    "license": "ISC",
    "dependencies": {
        "@mui/x-data-grid": "^7.28.3",
        "@mui/x-date-pickers": "6.8.0",
        "dayjs": "1.11.8",
        "mermaid": "^10.9.1"
    },
    "devDependencies": {
        "@monaco-editor/react": "^4.5.1",
        "@rollup/plugin-commonjs": "28.0.6",
        "@rollup/plugin-image": "^3.0.3",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "16.0.1",
        "@rollup/plugin-terser": "^0.4.4",
        "@rollup/plugin-typescript": "12.1.4",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.2.0",
        "@types/jest": "^29.5.14",
        "@types/react": "18.3.1",
        "@types/react-dom": "18.3.0",
        "dompurify": "^2.3.10",
        "echarts": "^5.5.1",
        "echarts-for-react": "^3.0.2",
        "monaco-editor": "^0.45.0",
        "react": "18.3.1",
        "react-beautiful-dnd": "^13.1.1",
        "react-hook-form": "^7.34.2",
        "react-vega": "^7.6.0",
        "rollup": "4.44.2",
        "rollup-plugin-delete": "3.0.1",
        "tslib": "2.5.3",
        "typescript": "~5.5.2",
        "vega": "^6.1.2",
        "vega-lite": "^6.2.0",
        "vitest": "^3.2.4",
        "@vitejs/plugin-react": "^4.6.0"
    },
    "peerDependencies": {
        "@emotion/react": "11.11.1",
        "@emotion/styled": "11.11.0",
        "@mui/icons-material": "6.0.0",
        "@mui/material": "6.0.0",
        "@semoss/sdk": "workspace:*",
        "@semoss/ui": "workspace:*",
        "mobx": "6.3.7",
        "mobx-react-lite": "^3.4.0",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-router-dom": "^6.3.0"
    }
}
