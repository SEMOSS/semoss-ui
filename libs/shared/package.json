{
  "name": "@semoss/shared",
  "version": "1.0.0-beta.1",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "sideEffects": ["**/*.css"],
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./flexlayout.css": "./src/components/flex-layout/flexlayout.css",
    "./assets/img/*": "./src/assets/img/*",
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./api": {
      "types": "./dist/types/api/index.d.ts",
      "default": "./dist/api.mjs"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "dev": "rollup -w -c",
    "build": "rollup -c --environment NODE_ENV:production",
    "build:dev": "rollup -c"
  },
  "license": "MIT",
  "dependencies": {
    "@iconify-icons/vscode-icons": "^1.1.18",
    "@iconify/react": "^5.2.0",
    "@monaco-editor/react": "^4.5.1",
    "@semoss/i18n": "workspace:*",
    "@semoss/sdk": "workspace:*",
    "@semoss/ui": "workspace:*",
    "dayjs": "1.11.8",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "flexlayout-react": "^0.8.1",
    "lucide-react": "^0.545.0",
    "monaco-editor": "^0.45.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "28.0.6",
    "@rollup/plugin-node-resolve": "16.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "12.1.4",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "rollup": "4.59.0",
    "rollup-plugin-delete": "3.0.1",
    "rollup-plugin-postcss": "^4.0.2",
    "tslib": "2.5.3",
    "typescript": "~5.5.2"
  },
  "peerDependencies": {}
}