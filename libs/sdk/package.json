        "react": "^19.0.0",
        "tslib": "2.5.3",
        "typescript": "~6.0.0",
        "vite": "^8.2.1",
        "vitest": "^4.1.10"
    },
    "peerDependencies": {
        "react": "^18.3.1 || ^19.0.0"
    },
