{
    "name": "@semoss/sdk",
    "version": "1.0.0-beta.48",
    "type": "module",
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "default": "./dist/index.mjs"
        },
        "./react": {
            "types": "./dist/types/js-frameworks/react/index.d.ts",
            "default": "./dist/js-frameworks/react/index.mjs"
        },
        "./api": {
            "types": "./dist/types/lib/api.d.ts",
            "default": "./dist/api/index.mjs"
        },
        "./api/health": {
            "types": "./dist/types/api/health/health.d.ts",
            "default": "./dist/api/health.mjs"
        }
    },
    "files": [
        "src",
        "dist",
        "contracts",
        "skills"
    ],
    "npmSkills": {
        "publish": {
            "source": "skills"
        }
    },
    "scripts": {
        "generate": "node ../../src/script/generate-sdk.ts",
        "generate:check": "node ../../src/script/generate-sdk.ts --check",
        "test:generator": "node --test ../../src/script/sdk-generator/*.test.ts",
        "dev": "vite build --watch --mode development --configLoader runner",
        "build": "vite build --configLoader runner",
        "build:dev": "vite build --mode development --configLoader runner",
        "test": "vitest run --configLoader runner",
        "test:integration": "pnpm build && vitest run --config vitest.integration.config.ts --configLoader runner",
        "test:watch": "vitest --watch --configLoader runner",
        "test:coverage": "vitest --coverage --watch=false --configLoader runner"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@semoss/config": "workspace:*",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.0",
        "@types/react": "^19.0.0",
        "@vitest/coverage-v8": "^4.1.11",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "typescript": "~6.0.0",
        "vite": "^8.2.1",
        "vitest": "^4.1.11"
    },
    "peerDependencies": {
        "react": "^18.3.1 || ^19.0.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        }
    }
}
