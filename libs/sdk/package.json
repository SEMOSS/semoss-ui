    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "default": "./dist/index.mjs"
        },
        "./react": {
            "types": "./dist/types/js-frameworks/react/index.d.ts",
            "default": "./dist/js-frameworks/react/index.mjs"
        }
    },
