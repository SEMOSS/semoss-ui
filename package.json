{
  "private": true,
  "name": "semoss",
  "description": "SEMOSS Analytics Platform",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "turbo run dev",
    "dev:client": "turbo run dev --filter=@semoss/client...",
    "dev:playground": "turbo run dev --filter=@semoss/playground...",
    "dev:collaboration": "turbo run dev --filter=@semoss/collaboration...",
    "dev:terminal": "turbo run dev --filter=@semoss/terminal...",
    "build": "turbo run build",
    "build:dev": "turbo run build:dev",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "check": "biome check",
    "fix": "biome check --write",
    "grit": "biome search",
    "clean": "knip"
  },
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/jest": "^29.5.14",
    "jsdom": "~31.0.1",
    "knip": "^5.88.1",
    "lefthook": "^1.12.2",
    "turbo": "^2.9.14",
    "typescript": "~6.0.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "pnpm": "~12.18.0",
    "node": ">=26.0.0 <27"
  }
}
