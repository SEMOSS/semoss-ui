      "brace-expansion@>=1 <1.1.18": "1.1.18",
      "brace-expansion@>=2 <2.1.4": "2.1.4",
      "browserslist@>=4 <4.28.9": "4.28.9",
      "ws@>=8 <8.21.3": "8.21.3",
      "vega-embed@>=6 <6.29.0": "6.29.0",
      "vega-functions@>=6 <6.1.1": "6.1.1"
