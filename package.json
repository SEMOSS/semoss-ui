{
  "private": true,
  "name": "semoss",
  "description": "SEMOSS Analytics Platform",
  "scripts": {
    "prepare": "husky install",
    "dev": "turbo run dev",
    "dev:client": "turbo run dev --filter=@semoss/client",
    "lint": "turbo run lint",
    "build": "turbo run build",
    "build:dev": "turbo run build:dev",
    "fix": "turbo run lint format",
    "format": "turbo run format",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "format-and-lint": "lint-staged",
    "format-and-lint-one:fix": "lint-staged:fix"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": ["biome check"]
  },
  "lint-staged:fix": {
    "*.{js,jsx,ts,tsx,json}": ["biome check --write"]
  },
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "2.1.1",
    "@commitlint/config-conventional": "^17.7.0",
    "@types/jest": "^29.5.14",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "husky": "^8.0.3",
    "jest": "29.7.0",
    "jsdom": "~22.1.0",
    "lint-staged": "^13.2.2",
    "turbo": "^2.5.4",
    "typescript": "~5.5.2"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "pnpm": "~10.13.0",
    "node": ">=24.4.0 <25"
  }
}
