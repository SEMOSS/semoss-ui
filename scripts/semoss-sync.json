{
	"backend": {
		"version": "5.5.0-SNAPSHOT",
		"released": false,
		"monolith": {
			"path": "../../../Monolith",
			"ref": "dev"
		},
		"semoss": {
			"path": "../../../Semoss",
			"ref": "dev"
		}
	},
	"targets": {
		"api": {
			"package": "libs/sdk",
			"syncedAt": "2026-10-23",
			"monolithCommit": "6fabb05737d5686ae763172559b992f16f7d37d9",
			"semossCommit": "12781b2478eb97e2a27a911e9bdbc94b6f34ee88",
			"ignore": [
				{
					"method": "POST",
					"path": "/saml/config/fedletapplication",
					"reason": "SAML assertion callback handled by SamlVerifierServlet; the identity provider submits this browser form"
				},
				{
					"method": "GET",
					"path": "/IdpSSOServlet",
					"reason": "Browser navigation for identity-provider-initiated SAML",
					"replacement": "monolith/auth.samlIdpUrl"
				},
				{
					"method": "GET",
					"path": "/SPSSOServlet",
					"reason": "Browser navigation for service-provider-initiated SAML",
					"replacement": "monolith/auth.samlSpUrl"
				},
				{
					"method": "GET",
					"path": "/api/auth/login/*",
					"reason": "OAuth browser-redirect routes (one per provider; /login/ms is a @Deprecated alias of /login/microsoft; /login/producthunt has @Path but no HTTP verb)",
					"replacement": "monolith/auth.loginUrl"
				},
				{
					"method": "GET",
					"path": "/api/auth/login2/*",
					"reason": "OAuth browser-redirect routes for connector credentials",
					"replacement": "monolith/auth.login2Url"
				},
				{
					"method": "GET",
					"path": "/api/project-{projectId}/landing",
					"reason": "HTML page the browser navigates to",
					"replacement": "monolith/project.landingUrl"
				},
				{
					"method": "GET",
					"path": "/github/install/app",
					"reason": "Browser navigation: 303 redirect to GitHub's app install page",
					"replacement": "github.appUrl"
				},
				{
					"method": "GET",
					"path": "/github/user/authorize",
					"reason": "Browser navigation: 303 redirect to GitHub OAuth",
					"replacement": "github.authorizeUrl"
				},
				{
					"method": "GET",
					"path": "/github/manifest/new",
					"reason": "Browser navigation: auto-submitting HTML form",
					"replacement": "github/manifest.newUrl"
				},
				{
					"method": "GET",
					"path": "/github/*/callback",
					"reason": "Redirect targets GitHub sends the browser to (install, OAuth, manifest); not called by clients"
				},
				{
					"method": "POST",
					"path": "/github/webhook",
					"reason": "Webhook called by GitHub (X-Hub-Signature-256 HMAC)"
				},
				{
					"method": "POST",
					"path": "/msgraph/notifications/*",
					"reason": "Webhooks called by Microsoft Graph (MicrosoftGraphNotificationService)"
				},
				{
					"method": "GET",
					"path": "/browserSocket/{sessionId}",
					"reason": "WebSocket upgrade (RemoteBrowserSessionWebSocket); use a WebSocket client",
					"replacement": "monolith/browser-sessions.browserSocketUrl"
				},
				{
					"method": "GET",
					"path": "/insightSocket",
					"reason": "WebSocket upgrade (InsightWebsocket); requires an authenticated session and insightId query parameter",
					"replacement": "monolith/session.insightSocketUrl"
				}
			]
		}
	}
}
