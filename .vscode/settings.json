{
	"search.exclude": {
		"**/*.rollup.cache": true,
		"**/dist": true,
		"**/target": true,
		"**/.turbo": true
	},
	"editor.defaultFormatter": "biomejs.biome",
	"editor.formatOnSave": false,
	"editor.codeActionsOnSave": {
		"source.fixAll.biome": "explicit",
		"source.organizeImports.biome": "explicit"
	},
	"files.associations": {
		"*.css": "tailwindcss"
	},
	"[javascript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[json]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"js/ts.tsdk.path": "node_modules/typescript/lib"
}
