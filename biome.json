{
	"$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "dev"
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/*.js",
			"**/*.mjs",
			"**/*.cjs",
			"**/*.mts",
			"**/*.cts",
			"**/*.jsonc",
			"**/*.jsx",
			"**/*.ts",
			"**/*.tsx",
			"**/*.json",
			"**/*.css",
			"!**/package.json",
			"!**/pnpm-lock.json"
		],
		"experimentalScannerIgnores": [
			"node_modules/**",
			"dist/**",
			"build/**",
			"storybook-static/**",
			".next/**",
			".turbo/**",
			"coverage/**",
			"**/*.min.js",
			"**/.DS_Store",
			"**/*.local",
			".history/**"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"complexity": {
				"noUselessFragments": "error"
			},
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": "error",
				"useHookAtTopLevel": "error",
				"useExhaustiveDependencies": {
					"fix": "none",
					"level": "error",
					"options": {}
				}
			},
			"style": {
				"noDefaultExport": "error",
				"noNonNullAssertion": "error",
				"useConst": "error"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noTsIgnore": { "level": "error", "fix": "none" },
				"noConsole": "off",
				"noDebugger": "error",
				"noVar": "error"
			},
			"a11y": {
				"useAltText": "error"
			},
			"nursery": {
				"useSortedClasses": {
					"level": "warn",
					"fix": "safe",
					"options": {}
				}
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							[":PACKAGE:", "!@semoss/**"],
							[":PACKAGE_WITH_PROTOCOL:", "!@semoss/**"],
							"@semoss/**",
							[":ALIAS:", "!@semoss/**"],
							":PATH:"
						]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteProperties": "asNeeded",
			"semicolons": "always",
			"trailingCommas": "all",
			"quoteStyle": "double",
			"indentWidth": 4,
			"lineWidth": 80
		}
	},
	"json": {
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		}
	},
	"css": {
		"formatter": {
			"enabled": false
		},
		"linter": {
			"enabled": false
		}
	},
	"overrides": [
		{
			"includes": ["libs/**/src/**", "packages/**/src/**"],
			"linter": {
				"rules": {
					"nursery": { "useReactFunctionComponents": "error" }
				}
			}
		},
		{
			"includes": ["**/src/assets/img/**", "**/src/assets/loginProviders/**"],
			"linter": { "enabled": false },
			"formatter": { "enabled": false }
		},
		{
			"includes": ["**/*.test.{js,ts,jsx,tsx}", "**/*.spec.{js,ts,jsx,tsx}"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.config.{js,ts,mjs}", "!**/src/**"],
			"linter": {
				"rules": {
					"style": {
						"noDefaultExport": "off"
					},
					"suspicious": {
						"noExplicitAny": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.d.ts"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off"
					}
				}
			}
		}
	]
}
