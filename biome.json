{
	"$schema": "https://biomejs.dev/schemas/2.1.1/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "dev"
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/*.js",
			"**/*.jsx",
			"**/*.ts",
			"**/*.tsx",
			"**/*.json",
			"**/*.css",
			"!**/package.json",
			"!**/pnpm-lock.json"
		],
		"experimentalScannerIgnores": [
			"node_modules/**",
			"dist/**",
			"build/**",
			".next/**",
			".turbo/**",
			"coverage/**",
			"**/*.min.js",
			"**/*.d.ts",
			"**/.DS_Store",
			"**/*.local",
			".history/**"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"complexity": {
				"noUselessFragments": "error"
			},
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": "error",
				"useExhaustiveDependencies": {
					"fix": "none",
					"level": "warn",
					"options": {}
				}
			},
			"style": {
				"useConst": "error"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noConsole": "off",
				"noDebugger": "error",
				"noVar": "error"
			},
			"a11y": {
				"useAltText": "error"
			},
			"nursery": {
				"useSortedClasses": {
					"level": "warn",
					"fix": "safe",
					"options": {}
				}
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							[":PACKAGE:", "!@semoss/**"],
							[":PACKAGE_WITH_PROTOCOL:", "!@semoss/**"],
							"@semoss/**",
							[":ALIAS:", "!@semoss/**"],
							":PATH:"
						]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteProperties": "asNeeded",
			"semicolons": "always",
			"trailingCommas": "all",
			"quoteStyle": "double",
			"indentWidth": 4,
			"lineWidth": 80
		}
	},
	"json": {
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		}
	},
	"css": {
		"formatter": {
			"enabled": false
		},
		"linter": {
			"enabled": false
		}
	},
	"overrides": [
		{
			"includes": ["**/*.test.{js,ts,jsx,tsx}", "**/*.spec.{js,ts,jsx,tsx}"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.config.{js,ts,mjs}"],
			"linter": {
				"rules": {
					"style": {
						"noDefaultExport": "off"
					},
					"suspicious": {
						"noExplicitAny": "off"
					}
				}
			}
		}
	]
}
