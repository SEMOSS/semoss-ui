    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@semoss/config": "workspace:*",
    "@types/node": "^24.3.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "~5.5.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
