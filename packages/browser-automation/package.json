    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@semoss/config": "workspace:*",
    "@types/node": "^24.3.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~6.0.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
