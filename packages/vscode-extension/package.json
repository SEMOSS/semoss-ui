{
    "name": "semoss-vscode",
    "displayName": "Semoss VSCode",
    "publisher": "Semoss",
    "description": "VSCode extension for Semoss applications with features for zipping, deploying, and managing multiple Semoss instances. Includes a modern chatbot interface for assistance.",
    "version": "1.0.0",
    "license": "UNLICENSED",
    "private": true,
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/main.js",
    "contributes": {
        "commands": [
            {
                "command": "semoss.zipanddeploy",
                "title": "Semoss: Zip and deploy"
            },
            {
                "command": "semoss.ziponly",
                "title": "Semoss: Zip only"
            },
            {
                "command": "semoss.deployonly",
                "title": "Semoss: Deploy only"
            },
            {
                "command": "semoss.authorize",
                "title": "Semoss: Authorize New Instance"
            },
            {
                "command": "semoss.selectInstance",
                "title": "Semoss: Select Instance"
            },
            {
                "command": "semoss.removeInstance",
                "title": "Semoss: Remove Instance"
            },
            {
                "command": "semoss.createNewApp",
                "title": "Semoss: Create New App"
            },
            {
                "command": "semoss.openChatbot",
                "title": "Semoss: Open Chatbot"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "semoss.zipanddeploy",
                    "when": "semoss.hasSmss && explorerResourceIsFolder && (resourceFilename == 'client' || resourceFilename == 'portals' || resourceFilename == 'py')",
                    "group": "z_commands@1"
                },
                {
                    "command": "semoss.ziponly",
                    "when": "semoss.hasSmss && explorerResourceIsFolder && (resourceFilename == 'client' || resourceFilename == 'portals' || resourceFilename == 'py')",
                    "group": "z_commands@2"
                },
                {
                    "command": "semoss.deployonly",
                    "when": "semoss.hasSmss && explorerResourceIsFolder && (resourceFilename == 'client' || resourceFilename == 'portals' || resourceFilename == 'py')",
                    "group": "z_commands@3"
                },
                {
                    "command": "semoss.zipanddeploy",
                    "when": "semoss.hasSmss && !explorerResourceIsFolder && resourceExtname == .smss",
                    "group": "z_commands@4"
                },
                {
                    "command": "semoss.ziponly",
                    "when": "semoss.hasSmss && !explorerResourceIsFolder && resourceExtname == .smss",
                    "group": "z_commands@5"
                },
                {
                    "command": "semoss.deployonly",
                    "when": "semoss.hasSmss && !explorerResourceIsFolder && resourceExtname == .smss",
                    "group": "z_commands@6"
                }
            ],
            "view/title": [
                {
                    "command": "semoss.openChatbot",
                    "when": "view == explorer",
                    "group": "navigation@1000"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "semossChatbotContainer",
                    "title": "Semoss Assistant",
                    "icon": "media/chatbot.svg"
                }
            ]
        },
        "views": {
            "semossChatbotContainer": [
                {
                    "type": "webview",
                    "id": "semossChatbotView",
                    "name": "Chatbot",
                    "icon": "media/chatbot.svg"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run build-chatbot && npm run esbuild-base -- --minify",
        "build-chatbot": "cd src/webviews/chatbot-react && npm run build",
        "esbuild-base": "esbuild ./extension.js --bundle --outfile=out/main.js --external:vscode --external:util --external:fs --external:path --external:os --external:crypto --external:http --external:https --external:stream --external:zlib --external:buffer --format=cjs --platform=node --metafile=out/meta.json",
        "esbuild": "npm run esbuild-base -- --sourcemap",
        "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
        "test-compile": "tsc -p ./",
        "typecheck": "tsc --noEmit -p ./",
        "lint": "node scripts/lint-stub.js",
        "package": "npm run clean && npm run vscode:prepublish && vsce package --no-dependencies",
        "clean": "rimraf out"
    },
    "devDependencies": {
        "@types/glob": "^8.1.0",
        "@types/mocha": "^10.0.1",
        "@types/node": "18.16.9",
        "@types/vscode": "^1.76.0",
        "@vscode/test-electron": "^2.2.3",
        "esbuild": "^0.25.4",
        "glob": "^8.1.0",
        "globals": "^16.0.0",
        "mocha": "^10.2.0",
        "rimraf": "^3.0.2",
        "typescript": "^4.9.5"
    },
    "dependencies": {
        "archiver": "^7.0.1",
        "axios": "^1.3.4",
        "form-data": "^4.0.0",
        "js-yaml": "^4.1.0",
        "ncp": "^2.0.0",
        "node-fetch": "^3.3.2",
        "node-stream-zip": "^1.15.0"
    },
    "packageManager": "pnpm@10.13.1",
    "engines": {
        "pnpm": "~10.13.0",
        "node": ">=24.4.0 <25",
        "vscode": "^1.90.0"
    }
}
