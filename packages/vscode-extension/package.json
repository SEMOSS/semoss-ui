{
    "name": "semoss-vscode",
    "displayName": "Semoss VSCode",
    "publisher": "Semoss",
    "description": "",
    "version": "0.0.1",
    "license": "UNLICENSED",
    "private": true,
    "engines": {
        "vscode": "^1.76.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./extension.js",
    "contributes": {
        "commands": [
            {
                "command": "semoss.zipanddeploy",
                "title": "Semoss: Zip and deploy"
            },
            {
                "command": "semoss.ziponly",
                "title": "Semoss: Zip only"
            },
            {
                "command": "semoss.deployonly",
                "title": "Semoss: Deploy only"
            },
            {
                "command": "semoss.authorize",
                "title": "Semoss: Authorize New Instance"
            },
            {
                "command": "semoss.selectInstance",
                "title": "Semoss: Select Instance"
            },
            {
                "command": "semoss.removeInstance",
                "title": "Semoss: Remove Instance"
            },
            {
                "command": "semoss.createNewApp",
                "title": "Semoss: Create New App"
            },
            {
                "command": "semoss.openChatbot",
                "title": "Semoss: Open Chatbot"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "semoss.zipanddeploy",
                    "when": "explorerResourceIsFolder && resourceFilename == 'client' || resourceFilename == 'portals' || resourceFilename == 'py'",
                    "group": "z_commands"
                },
                {
                    "command": "semoss.ziponly",
                    "when": "explorerResourceIsFolder && resourceFilename == 'client' || resourceFilename == 'portals' || resourceFilename == 'py'",
                    "group": "z_commands"
                },
                {
                    "command": "semoss.deployonly",
                    "when": "explorerResourceIsFolder && resourceFilename == 'client' || resourceFilename == 'portals' || resourceFilename == 'py'",
                    "group": "z_commands"
                }
            ],
            "view/title": [
                {
                    "command": "semoss.openChatbot",
                    "when": "view == explorer",
                    "group": "navigation@1000"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "semossChatbotContainer",
                    "title": "Semoss Assistant",
                    "icon": "media/chatbot.svg"
                }
            ]
        },
        "views": {
            "semossChatbotContainer": [
                {
                    "type": "webview",
                    "id": "semossChatbotView",
                    "name": "Chatbot",
                    "icon": "media/chatbot.svg"
                }
            ]
        }
    },
    "scripts": {
        "lint": "eslint .",
        "pretest": "npm run lint",
        "test": "node ./test/runTest.js",
        "vscode:prepublish": "npm run esbuild-base -- --minify",
        "esbuild-base": "esbuild ./extension.js --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node",
        "esbuild": "npm run esbuild-base -- --sourcemap",
        "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
        "test-compile": "tsc -p ./"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "^3.832.0",
        "@eslint/js": "^9.26.0",
        "@types/glob": "^8.1.0",
        "@types/mocha": "^10.0.1",
        "@types/node": "16.x",
        "@types/vscode": "^1.76.0",
        "@vscode/test-electron": "^2.2.3",
        "esbuild": "^0.25.4",
        "eslint": "^8.57.1",
        "glob": "^8.1.0",
        "globals": "^16.0.0",
        "mocha": "^10.2.0",
        "typescript": "^4.9.5"
    },
    "dependencies": {
        "archiver": "^7.0.1",
        "axios": "^1.3.4",
        "ncp": "^2.0.0",
        "unzipper": "^0.12.3"
    }
}
