{
	"compilerOptions": {
		"declaration": true,
		"outDir": "dist",
		"rootDir": "src",
		"strict": true,
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"skipLibCheck": true,
		"noUncheckedSideEffectImports": false,
		"types": ["node"]
	},
	"include": ["./src/**/*"],
	"ts-node": {
		"esm": true
	}
}
