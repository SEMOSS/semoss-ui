{
	"compilerOptions": {
		"declaration": true,
		"outDir": "dist",
		"rootDir": "src",
		"strict": true,
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"esModuleInterop": true,
		"resolveJsonModule": true
	},
	"include": ["./src/**/*"],
	"ts-node": {
		"esm": true
	}
}
