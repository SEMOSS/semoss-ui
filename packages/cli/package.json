{
    "name": "@semoss/cli",
    "version": "1.0.0-beta.15",
    "type": "module",
    "types": "dist/index.d.ts",
    "files": [
        "/bin",
        "/dist",
        "/npm-shrinkwrap.json",
        "/oclif.manifest.json"
    ],
    "exports": "./lib/index.js",
