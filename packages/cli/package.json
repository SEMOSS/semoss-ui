    },
    "dependencies": {
        "@oclif/core": "^3",
        "@oclif/plugin-help": "^5",
        "@oclif/plugin-plugins": "^3.7.0",
        "@semoss/sdk": "workspace:*",
        "adm-zip": "^0.5.10",
        "dotenv": "^16.0.1",
        "glob": "^10.5.0",
        "listr": "^0.14.3"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.3",
        "@types/listr": "^0.14.7",
        "@types/node": "^18",
        "add": "^2.0.6",
        "shx": "^0.3.4",
        "ts-node": "^10.9.2",
        "typescript": "^5"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "oclif": {
        "bin": "@semoss/cli",
        "dirname": "@semoss/cli",
        "commands": "./dist/commands",
        "plugins": [
            "@oclif/plugin-help",
            "@oclif/plugin-plugins"
        ]
    }
