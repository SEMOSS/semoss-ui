{
	"compilerOptions": {
		"target": "es6",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"checkJs": false,
		"skipLibCheck": true,
		"strict": false,
		"forceConsistentCasingInFileNames": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"experimentalDecorators": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["client/*"]
		},
		"outDir": "./portals"
	},
	"include": ["./client/**/*", "vite-env.d.ts"]
}
