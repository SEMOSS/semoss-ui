{
    "compilerOptions": {
      "target": "es5",
      "paths": {
        "@semoss/renderer": ["../../libs/renderer/src/index.ts"],
        "@semoss/sdk": ["../../libs/sdk/src/index.ts"]
      },
      "lib": ["dom", "dom.iterable", "esnext"],
      "allowJs": true,
      "skipLibCheck": true,
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "strict": true,
      "forceConsistentCasingInFileNames": true,
      "module": "esnext",
      "moduleResolution": "node",
      "resolveJsonModule": true,
      "isolatedModules": true,
      "noEmit": true,
      "jsx": "react-jsx"
    },
    "include": ["src"]
  }