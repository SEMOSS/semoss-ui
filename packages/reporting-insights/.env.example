# Development Server
VITE_PORT=5173

# Semoss Backend (Required)
# ENDPOINT = Semoss origin; MODULE = module path.
# Leave ENDPOINT empty when deployed inside Semoss (uses own origin).
ENDPOINT=http://localhost:9090
MODULE=/Monolith

# MCP (Optional)
# The Python driver auto-detects APP_URL at runtime. Override only if needed:
# REPORTING_INSIGHTS_URL=https://thisissemoss.org/Monolith/public_home/<projectId>/portals/
