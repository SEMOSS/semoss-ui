# Development Server Configuration
VITE_PORT=5173
VITE_HOST=localhost

# Semoss Configuration (Required)
# ENDPOINT = the Semoss backend origin; MODULE = its module path.
# Used by the Vite proxy to forward API calls AND to build absolute links to
# published apps (e.g. ${ENDPOINT}${MODULE}/public_home/<id>/portals/).
# When the app is deployed inside Semoss, leave ENDPOINT empty and the app's
# own origin is used instead.
ENDPOINT=http://localhost:9090
MODULE=/Monolith

# MCP registration (Semoss Playground) — deployment-correct URLs.
# The MCP host + each deployed dashboard bake absolute URLs into their tool
# `resourceURI`s so the playground (running on the Semoss/Tomcat origin) can open
# them. If you register/deploy while running the Vite DEV server, window.location
# is the dev port (e.g. http://localhost:5176/) — which the playground can't reach.
#   • Set ENDPOINT (above) to the Semoss origin so DASHBOARD portal links are correct.
#   • Set VITE_APP_URL to THIS app's deployed URL so the HOST tools/redirect are correct.
# Leave BOTH empty only when you register from the built app served under Tomcat
# (then window.location is already correct).
# VITE_APP_URL=http://localhost:9090/SemossWeb/packages/reporting-insights/dist/

# AI Dashboard Builder: no env config needed — the user picks a model engine in
# the modal (populated from MyEngines(engineTypes=['MODEL'])).

# Optional: Authentication (uncomment if needed)
# ACCESS_KEY=
# SECRET_KEY=

# Optional: Application-specific settings (uncomment if needed)
# APP=your-app-id
# CLIENT_ID=your-client-id
# ASK_MODEL=your-model-id
# VECTOR_DATABASE=your-vector-db
