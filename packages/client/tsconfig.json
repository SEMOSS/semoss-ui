{
	"compilerOptions": {
		/* Lang and Env */
		"lib": ["ES2022", "dom"],
		"target": "es6",
		"jsx": "react-jsx",
		"types": ["vitest/globals", "@testing-library/jest-dom/vitest"],

		/* Modules */
		"module": "esnext",
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,

		/* Skip */
		"skipLibCheck": true,
		"allowJs": true,
		"esModuleInterop": true,
		"isolatedModules": true,

		/* Lang and Env */
		"paths": {
			"@/assets/img/*": ["../../libs/shared/src/assets/img/*"],
			"@/assets/loginProviders/*": [
				"../../libs/shared/src/assets/loginProviders/*"
			],
			"@/*": ["./src/*"]
		}
	},
	"include": ["src", "../../libs/shared/src/assets"],
	"exclude": ["dist", "node_modules"]
}
