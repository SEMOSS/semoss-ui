{
    "name": "@semoss/playground",
    "private": true,
    "scripts": {
        "dev": "vite --configLoader runner --mode development",
        "build": "vite build --configLoader runner --mode production",
        "build:dev": "vite build --configLoader runner --mode development",
        "type-check": "tsc --pretty --noEmit",
        "test": "vitest run --configLoader runner",
        "test:ui": "vitest --ui --configLoader runner",
        "test:watch": "vitest --watch --configLoader runner",
        "test:coverage": "vitest --coverage --watch=false --configLoader runner"
    },
    "dependencies": {
        "@codesandbox/sandpack-react": "^2.20.0",
        "@lexical/react": "^0.39.0",
        "@semoss/i18n": "workspace:*",
        "@semoss/sdk": "workspace:*",
        "@semoss/shared": "workspace:*",
        "@semoss/ui": "workspace:*",
        "dayjs": "1.11.8",
        "lexical": "^0.39.0",
        "lucide-react": "^0.545.0",
        "mermaid": "^11.15.0",
        "mobx": "6.3.7",
        "mobx-react-lite": "^4.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-router": "8.3.0",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@semoss/config": "workspace:*",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.2.0",
        "@testing-library/user-event": "^14.4.3",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitest/coverage-v8": "^4.1.10",
        "@vitest/ui": "^4.1.10",
        "typescript": "~6.0.0",
        "vite": "^8.2.1",
        "vitest": "^4.1.10"
    }
}
