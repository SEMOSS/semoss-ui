{
    "name": "@semoss/playground",
    "private": true,
    "scripts": {
        "dev": "vite --configLoader runner --mode development",
        "build": "vite build --configLoader runner --mode production",
        "build:dev": "vite build --configLoader runner --mode development",
        "type-check": "tsc --pretty --noEmit",
        "test": "vitest run --configLoader runner",
        "test:ui": "vitest --ui --configLoader runner",
        "test:watch": "vitest --watch --configLoader runner",
        "test:coverage": "vitest --coverage --watch=false --configLoader runner"
    },
    "dependencies": {
        "@semoss/chat": "workspace:*",
        "@semoss/connectors": "workspace:*",
        "@semoss/i18n": "workspace:*",
        "@semoss/panels": "workspace:*",
        "@semoss/sdk": "workspace:*",
        "@semoss/shared": "workspace:*",
        "@semoss/ui": "workspace:*",
        "@semoss/utility": "workspace:*",
        "@semoss/workbench": "workspace:*",
        "lucide-react": "^0.545.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-router": "8.3.0",
        "zustand": "^5.0.0"
    },
    "devDependencies": {
        "@semoss/config": "workspace:*",
        "@testing-library/jest-dom": "8.0.0",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.13",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitest/coverage-v8": "5.1.1",
        "@vitest/ui": "5.1.1",
        "typescript": "~6.0.0",
        "vite": "8.3.8",
        "vitest": "5.1.1"
    }
}
