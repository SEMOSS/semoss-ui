## Dev Variables
# path to server
ENDPOINT=http://localhost:9090

# name of deployed instance
MODULE=/Monolith



## THEMING
VITE_APP_NAME="Playground"
VITE_APP_DESCRIPTION="Note: This is a demo environment to be used for testing purposes only."
VITE_LOGO_PATH=""
VITE_LOGO_FULL_PATH=""

# default model
VITE_DEFAUlT_MODEL="e4449559-bcff-4941-ae72-0e3f18e06660";

# embedding model for documents
VITE_EMBEDDING_MODEL="e4449559-bcff-4941-ae72-0e3f18e06660"

# flags
VITE_ENABLE_MODEL_SELECT=true
VITE_ENABLE_FILE_UPLOAD=true
VITE_ENABLE_TASK=true
VITE_ENABLE_TOOLS=true
