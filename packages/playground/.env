## Dev Variables
# path to server
ENDPOINT=http://localhost:9090

# name of deployed instance
MODULE=/Monolith


# PLATFORM
VITE_PLATFORM_URL="../../client/dist"


## THEMING
VITE_APP_NAME="Playground"
VITE_APP_DESCRIPTION="This is a demo environment for learning purposes only. Ready to start exploring and experimenting?"
VITE_APP_LOGO_PATH="./logo.svg"
VITE_APP_THEME="{}"

# default model
VITE_DEFAUlT_MODEL_ID="";
VITE_DEFAUlT_MODEL_NAME="";

# flags
VITE_ENABLE_MODEL_SELECT=true
VITE_ENABLE_TOOLS=true
VITE_ENABLE_ATTACHMENT=true
VITE_ENABLE_WORKSPACE=true
