## Dev Variables
# path to server
ENDPOINT=http://localhost:9090

# name of deployed instance
MODULE=/Monolith


# PLATFORM
VITE_PLATFORM_URL="../../client/dist"


## THEMING
VITE_NAME="Playground"
VITE_THEME="{}"

# default model
VITE_DEFAUlT_MODEL_ID="";
VITE_DEFAUlT_MODEL_NAME="";

# flags
VITE_ENABLE_MODEL_SELECT=true
VITE_ENABLE_AGENT=true
VITE_ENABLE_SUGGESTIONS=false
VITE_ENABLE_PLAN=true
VITE_ENABLE_REWRITE=true
VITE_ENABLE_IMAGE_GEN=true