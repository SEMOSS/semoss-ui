# Dev Variables
# path to server
ENDPOINT=http://localhost:9090

# name of deployed instance
MODULE=/Monolith

APP_NAME="Playground"
APP_DESCRIPTION="Note: This is a demo environment to be used for testing purposes only."
LOGO_PATH=""
LOGO_FULL_PATH=""

# default model
DEFAUlT_MODEL="e4449559-bcff-4941-ae72-0e3f18e06660";

# embedding model for documents
EMBEDDING_MODEL="e4449559-bcff-4941-ae72-0e3f18e06660"

# flags
ENABLE_MODEL_SELECT=true
ENABLE_FILE_UPLOAD=true
ENABLE_TASK=true
ENABLE_TOOLS=true
