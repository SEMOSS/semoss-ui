{
	"manifest_version": 3,
	"name": "Workshop Automation Assistant",
	"description": "Browser automation using Workshop AI platform",
	"version": "1.0.0",
	"permissions": ["tabs", "activeTab", "storage", "debugger", "scripting", "sidePanel"],
	"host_permissions": ["http://*/*", "https://*/*"],
	"icons": {
		"16": "assets/icon-16.svg",
		"48": "assets/icon-48.svg",
		"128": "assets/icon-128.svg"
	},
	"background": {
		"service_worker": "background.bundle.js"
	},
	"action": {
		"default_title": "Workshop Automation Assistant",
		"default_icon": {
			"16": "assets/icon-16.svg",
			"48": "assets/icon-48.svg",
			"128": "assets/icon-128.svg"
		}
	},
	"side_panel": {
		"default_path": "panel.html"
	},
	"options_page": "options/index.html",
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["content.bundle.js"],
			"run_at": "document_idle"
		}
	],
	"devtools_page": "devtools.html"
}
