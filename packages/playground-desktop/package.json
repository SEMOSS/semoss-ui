{
    "name": "@semoss/playground-desktop",
    "private": true,
    "version": "0.1.0",
    "scripts": {
        "dev": "vite --configLoader runner --mode development",
        "build": "vite build --configLoader runner --mode production",
        "type-check": "tsc --pretty --noEmit",
        "test": "vitest run --configLoader runner",
        "test:watch": "vitest --watch --configLoader runner",
        "tauri:dev": "cd src-tauri && cargo tauri dev",
        "tauri:build": "cd src-tauri && cargo tauri build"
    },
    "dependencies": {
        "@semoss/chat": "workspace:*",
        "@semoss/connectors": "workspace:*",
        "@semoss/i18n": "workspace:*",
        "@semoss/panels": "workspace:*",
        "@semoss/sdk": "workspace:*",
        "@semoss/shared": "workspace:*",
        "@semoss/ui": "workspace:*",
        "@semoss/utility": "workspace:*",
        "@semoss/workbench": "workspace:*",
        "lucide-react": "^0.545.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-router": "8.3.0",
        "zustand": "^5.0.0"
    },
    "devDependencies": {
        "@semoss/config": "workspace:*",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.2.0",
        "@testing-library/user-event": "^14.4.3",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "typescript": "~6.0.0",
        "vite": "^8.2.1",
        "vitest": "^4.1.11"
    }
}
