{
	"name": "@semoss/playground-desktop",
	"private": true,
	"version": "1.0.0-beta.1",
	"productName": "Playground",
	"description": "Playground: the chat UI, signed in to hosted SEMOSS servers.",
	"main": "out/main/main.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"preview": "electron-vite preview",
		"package": "electron-vite build && electron-builder --dir",
		"dist": "electron-vite build && electron-builder",
		"test": "vitest run --configLoader runner",
		"type-check": "tsc --pretty --noEmit -p tsconfig.json && tsc --pretty --noEmit -p tsconfig.node.json"
	},
	"devDependencies": {
		"@semoss/chat": "workspace:*",
		"@semoss/config": "workspace:*",
		"@semoss/connectors": "workspace:*",
		"@semoss/i18n": "workspace:*",
		"@semoss/panels": "workspace:*",
		"@semoss/sdk": "workspace:*",
		"@semoss/shared": "workspace:*",
		"@semoss/ui": "workspace:*",
		"@semoss/utility": "workspace:*",
		"@semoss/workbench": "workspace:*",
		"@tailwindcss/vite": "4.3.5",
		"@testing-library/jest-dom": "8.0.0",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.13",
		"@types/node": "^26.0.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "6.3.0",
		"electron": "^45.0.0",
		"electron-builder": "^26.0.0",
		"electron-vite": "^6.0.0",
		"http-proxy-3": "^2.0.2",
		"jsdom": "~22.1.0",
		"lucide-react": "^0.545.0",
		"postcss": "^8.5.6",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-router": "8.3.0",
		"rolldown": "~1.2.18",
		"typescript": "~6.0.0",
		"unplugin-dts": "1.1.2",
		"vite": "8.3.8",
		"vite-plugin-svgr": "5.2.0",
		"vitest": "5.1.1"
	}
}
