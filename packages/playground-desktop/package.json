		"@semoss/shared": "workspace:*",
		"@semoss/ui": "workspace:*",
		"@semoss/utility": "workspace:*",
		"@semoss/workbench": "workspace:*",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^6.6.3",
		"@types/node": "^26.0.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^6.0.5",
		"electron": "^45.0.0",
		"electron-builder": "^26.0.0",
		"electron-vite": "^6.0.0",
		"http-proxy-3": "^2.0.2",
