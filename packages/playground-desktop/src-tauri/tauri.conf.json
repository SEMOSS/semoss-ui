{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "SEMOSS Playground",
	"version": "0.1.0",
	"identifier": "org.semoss.playground-desktop",
	"build": {
		"beforeDevCommand": { "script": "pnpm dev", "cwd": ".." },
		"devUrl": "http://localhost:5181",
		"beforeBuildCommand": { "script": "pnpm build", "cwd": ".." },
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "main",
				"create": false,
				"title": "SEMOSS Playground",
				"width": 1280,
				"height": 820,
				"minWidth": 960,
				"minHeight": 640,
				"resizable": true,
				"dragDropEnabled": false,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"trafficLightPosition": { "x": 16, "y": 18 }
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; frame-src https: http://localhost:*"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "Productivity",
		"shortDescription": "SEMOSS Playground",
		"longDescription": "Chat with SEMOSS models, agents and knowledge from the desktop.",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
