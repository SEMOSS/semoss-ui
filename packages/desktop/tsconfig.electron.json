{
	"compilerOptions": {
		"lib": ["ES2022"],
		"target": "ES2022",
		"module": "commonjs",
		"moduleResolution": "node",
		"outDir": "dist-electron",
		"rootDir": "electron",
		"types": ["node", "electron"],
		"esModuleInterop": true,
		"skipLibCheck": true,
		"strict": true,
		"resolveJsonModule": true
	},
	"include": ["electron"]
}
