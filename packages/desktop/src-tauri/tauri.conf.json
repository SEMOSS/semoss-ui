{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "AI Core",
	"version": "0.1.0",
	"identifier": "org.semoss.aicore",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:5180",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "AI Core",
				"width": 1280,
				"height": 820,
				"minWidth": 960,
				"minHeight": 640,
				"resizable": true,
				"fullscreen": false,
				"decorations": true,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"trafficLightPosition": {
					"x": 16,
					"y": 18
				},
				"transparent": false
			}
		],
		"security": {
			"csp": "default-src 'self'; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:* https://workshop.cfg.deloitte.com; frame-src https://workshop.cfg.deloitte.com"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "DeveloperTool",
		"shortDescription": "AI Core desktop workspace",
		"longDescription": "A focused desktop workspace for AI Core applications, engines, Playground, and workbenches.",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
