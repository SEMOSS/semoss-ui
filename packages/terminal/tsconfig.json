{
	"compilerOptions": {
		"lib": ["ES2022", "dom"],
		"target": "es6",
		"jsx": "react-jsx",
		"module": "esnext",
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"allowJs": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"strict": true,
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["vite-env.d.ts", "src"],
	"exclude": ["dist", "node_modules"]
}
