        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@semoss/config": "workspace:*",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "typescript": "~5.5.2",
        "vite": "^8.2.1",
        "vitest": "^4.1.10"
